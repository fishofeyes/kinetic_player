{
  "name": "kinetic-player-web",
  "private": true,
  "version": "2.1.1",
  "description": "Artplayer.js bridge for kinetic_player Flutter Web",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=iife --global-name=KineticArtplayerBundle --outfile=../assets/web/kinetic_artplayer.js --minify",
    "build:dev": "esbuild src/index.ts --bundle --format=iife --global-name=KineticArtplayerBundle --outfile=../assets/web/kinetic_artplayer.js --sourcemap",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "artplayer": "5.4.0",
    "artplayer-plugin-ads": "1.0.6",
    "artplayer-plugin-ambilight": "1.1.0",
    "artplayer-plugin-asr": "2.1.0",
    "artplayer-plugin-audio-track": "1.1.0",
    "artplayer-plugin-auto-thumbnail": "1.1.0",
    "artplayer-plugin-chapter": "1.1.0",
    "artplayer-plugin-chromecast": "1.1.0",
    "artplayer-plugin-danmuku": "5.3.0",
    "artplayer-plugin-dash-control": "1.1.0",
    "artplayer-plugin-document-pip": "1.1.0",
    "artplayer-plugin-hls-control": "1.1.0",
    "artplayer-plugin-jassub": "1.1.0",
    "artplayer-plugin-multiple-subtitles": "1.2.0",
    "artplayer-plugin-vast": "1.0.0",
    "artplayer-plugin-vtt-thumbnail": "1.1.0",
    "dashjs": "5.2.1",
    "hls.js": "1.7.3"
  },
  "optionalDependencies": {
    "artplayer-plugin-danmuku-mask": "1.1.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
